{
  "name": "@openmrs/esm-medication-side-effects-app",
  "version": "1.0.0",
  "license": "MPL-2.0",
  "description": "Displays known side effects for a medication, injected into host applications via extension slots",
  "browser": "dist/openmrs-esm-medication-side-effects-app.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
    "serve": "rspack serve --mode=development",
    "build": "rspack --mode=production",
    "analyze": "rspack --mode=production --env analyze=true",
    "lint": "eslint src",
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "test:watch": "cross-env TZ=UTC vitest watch",
    "typescript": "tsc",
    "verify": "turbo run lint test typescript",
    "extract-translations": "i18next 'src/**/*.component.tsx' 'src/index.ts' --config ./tools/i18next-parser.config.js",
    "check-translations": "yarn extract-translations && git diff --exit-code -- translations/en.json",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests"
  },
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "keywords": [
    "openmrs",
    "microfrontends",
    "medication",
    "side-effects"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openmrs/openmrs-esm-medication-side-effects.git"
  },
  "homepage": "https://github.com/openmrs/openmrs-esm-medication-side-effects#readme",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/openmrs/openmrs-esm-medication-side-effects/issues"
  },
  "dependencies": {
    "@carbon/react": "^1.83.0"
  },
  "peerDependencies": {
    "@openmrs/esm-framework": "10.x",
    "dayjs": "1.x",
    "react": "18.x",
    "react-dom": "18.x",
    "react-i18next": "16.x",
    "rxjs": "6.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "@openmrs/eslint-config": "^2.0.0",
    "@openmrs/esm-framework": "next",
    "@swc/core": "^1.7.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.0",
    "@types/webpack-env": "^1.16.0",
    "@vitest/coverage-v8": "^4.1.2",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.13",
    "eslint": "^9.39.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "i18next": "^25.0.0",
    "i18next-parser": "^9.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^28.0.0",
    "openmrs": "next",
    "prettier": "^3.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.0.0",
    "rxjs": "^6.6.7",
    "swr": "2.2.5",
    "turbo": "^2.5.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.2"
  },
  "packageManager": "yarn@4.10.3"
}
